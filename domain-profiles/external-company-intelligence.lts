## 11. Traversal Policy

```yaml
traversal:
  default_entry_points: ["CO-OVERVIEW"]
  primary_layers: [causal, temporal]
  focus_areas:
    factbase:
      entry: ["CO-OVERVIEW"]
      layers: [semantic, entity]
      keywords: ["company", "overview", "basics", "who"]
    financials:
      entry: ["REV-LATEST", "CF-BURN-RATE", "CF-RUNWAY"]
      layers: [temporal, causal]
      keywords: ["revenue", "burn", "cash", "runway", "financials", "raise"]
    technology:
      entry: ["PROD-INDEX"]
      layers: [semantic, causal]
      keywords: ["product", "technology", "platform", "IP", "patent"]
    messaging:
      entry: ["CRED-ROLLING-SCORE"]
      layers: [temporal, causal]
      keywords: ["credibility", "spin", "claims", "press release", "jedi", "frame"]
    patterns:
      entry: ["PAT-INDEX"]
      layers: [causal, semantic]
      keywords: ["pattern", "anti-pattern", "indicator", "signal", "trajectory"]
    competitive:
      entry: ["COMP-INDEX"]
      layers: [semantic]
      keywords: ["competitors", "market", "positioning", "comps", "landscape"]
    forecast:
      entry: ["SCN-PERFORM"]
      layers: [causal, temporal]
      keywords: ["forecast", "projection", "scenario", "model", "predict"]
    risk:
      entry: ["RISK-INDEX"]
      layers: [causal]
      keywords: ["risk", "threat", "downside", "delisting", "dilution", "runway"]
    breakout:
      entry: ["BREAKOUT-INDEX"]
      layers: [causal, semantic]
      keywords: ["breakout", "category", "mandate", "agent", "delegation"]
    rumors:
      entry: ["RMR-INDEX"]
      layers: [semantic, causal]
      keywords: ["rumor", "heard", "unverified", "whisper"]
```

